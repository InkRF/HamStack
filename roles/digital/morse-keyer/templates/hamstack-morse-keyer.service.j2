[Unit]
Description=HamStack Morse key to virtual keyboard bridge (HamRadioVillage morse-keyer)
After=multi-user.target

[Service]
Type=simple
User={{ hamstack_morse_keyer_user }}
Group={{ hamstack_morse_keyer_group }}
SupplementaryGroups={{ hamstack_morse_keyer_user_groups | join(' ') }}
# gpiozero's lgpio backend writes notification files into its working directory.
StateDirectory=hamstack-morse-keyer
WorkingDirectory=/var/lib/hamstack-morse-keyer
ExecStart=/usr/bin/python3 {{ hamstack_morse_keyer_install_dir }}/morse_keyer.py --mode {{ hamstack_morse_keyer_mode }} --gpio {{ hamstack_morse_keyer_gpio | int }} --dah-gpio {{ hamstack_morse_keyer_dah_gpio | int }} --key {{ hamstack_morse_keyer_key }} --bounce-ms {{ hamstack_morse_keyer_bounce_ms }} --wpm {{ hamstack_morse_keyer_wpm }}
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
