# Managed by HamStack (digital/slowrxd). Local changes are overwritten.
# scripts/sstv-loopback-test.sh reads this file to reproduce the service
# command line against a loopback capture device.
SLOWRXD_OUTPUT_DIR={{ hamstack_slowrxd_output_dir }}
SLOWRXD_DEVICE={{ hamstack_slowrxd_device }}
SLOWRXD_SAMPLE_RATE={{ hamstack_slowrxd_sample_rate | int }}
SLOWRXD_CHANNEL={{ hamstack_slowrxd_channel }}
SLOWRXD_HOOK_ARGS="{{ ('-x ' ~ hamstack_slowrxd_hook_path) if hamstack_slowrxd_hook_url | length > 0 else '' }}"
SLOWRXD_EXTRA_ARGS="{{ hamstack_slowrxd_extra_args | join(' ') }}"
